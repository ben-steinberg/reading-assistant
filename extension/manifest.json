{
  "manifest_version": 3,
  "name": "Japanese Reading Assistant",
  "version": "1.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://news.yahoo.co.jp/*", "https://www3.nhk.or.jp/*"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ]
}